# Rivora AI — environment variable template (Sub-Task 1)
# Copy this file to .env and fill in values from your IBM watsonx.ai project.
# Never commit a populated .env file.

# IBM Cloud API key with access to the watsonx.ai project
WATSONX_API_KEY=

# watsonx.ai project ID
WATSONX_PROJECT_ID=

# Regional watsonx.ai endpoint (example: Dallas)
# Confirm the URL for your actual region in IBM Cloud.
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Granite model ID enabled for the project/region
# Plan recommendations: ibm/granite-13b-instruct-v2 or ibm/granite-3-8b-instruct
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct
